# Copy to .env and fill in. Never commit .env. No real values belong in this file.

PORT=5000
# MongoDB connection string for the app (required)
MONGO_URI=
# Long random value, 32+ chars (required). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional: development | production. Production enforces a strong JWT_SECRET and CORS_ORIGINS.
NODE_ENV=development

# IANA timezone used to decide what "today" is when rejecting past check-in
# dates (default: Asia/Karachi). Use e.g. UTC or Europe/London if that fits your market.
BOOKING_TIMEZONE=Asia/Karachi

# --- Step 2 security settings (all optional in development) ---
# Comma-separated allowed frontend origins. REQUIRED when NODE_ENV=production.
# e.g. CORS_ORIGINS=https://stayeasy.example.com
CORS_ORIGINS=
# Set when running behind a reverse proxy / load balancer (see TRUST_PROXY handling in security.js)
TRUST_PROXY=
# bcrypt cost, integer 10-15 (default 12)
BCRYPT_ROUNDS=
# Positive integers; leave blank for the built-in defaults
API_RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_MAX=
AUTH_REGISTER_LIMIT_MAX=
# Max JSON request body size (default 100kb)
JSON_BODY_LIMIT=

# --- Seed script (npm run seed) ---
# There are NO default passwords. The seed refuses to run unless both passwords
# are set: 8-72 bytes, no leading/trailing spaces, and different from each other.
# Choose your own values in your local .env.
# Emails are optional (defaults: admin@stayeasy.com / guest@stayeasy.com).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# --- Image uploads (optional) ---
# Cloudinary signed uploads for hotel/room images and profile photos. Leave blank to disable:
# POST /api/uploads/signature then answers 503, admins paste https image URLs instead and
# profile photo upload is unavailable. Profile photos go to <CLOUDINARY_UPLOAD_FOLDER>/avatars.
# The API secret is used only on the server and is never sent to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder uploads are placed in (default: stayeasy)
CLOUDINARY_UPLOAD_FOLDER=
